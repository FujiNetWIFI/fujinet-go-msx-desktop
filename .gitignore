build/
build-*/
# ...but build-aux/ is source, not output: it holds the flatpak manifests
# (the directory name is GNOME Builder's convention). Without this the
# pattern above swallows new files there silently -- they never show up as
# untracked, so a manifest can be "added" and still be missing from CI.
!build-aux/
compile_commands.json

# Staged from the openMSX sources by cmake/StageOpenMSX.cmake.
core/openmsx-generated/

# openMSX, cloned at a pinned commit (or the FujiNetWIFI fork submodule) by
# cmake/Dependencies.cmake when OPENMSX_SRC is not set to point at an
# existing checkout.
third_party/openmsx/

# fujinet-firmware, cloned at a pinned commit by the same mechanism when
# FUJINET_SRC is not set to point at an existing checkout.
third_party/fujinet-firmware/

# Generated by tools/fujinet/build-fujinet-desktop.sh.
tools/fujinet/work/

# Generated by tools/openmsx/build-openmsx-desktop.sh (per-ABI archives,
# staged 3rd-party build directories).
tools/openmsx/work/

# flatpak-builder's state directory.
.flatpak-builder/
build-flatpak*/
repo/
